// Niri configuration.
// Niri reloads this file automatically after edits.

output "DP-1" {
    mode "2560x1440@200.000"
    scale 1
    position x=0 y=0
}

output "DP-2" {
    mode "1920x1080@179.999"
    scale 1
    position x=-1920 y=0
}

input {
    mouse {
        // Keep pointer focus independent of pointer motion.
    }
}

layout {
    gaps 1
    center-focused-column "never"
    default-column-width { proportion 0.5; }

    border {
        on
        width 0.5
        active-color "#cba6f7"
        inactive-color "#45475a"
        urgent-color "#f38ba8"
    }
}

prefer-no-csd
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"
hotkey-overlay {
    skip-at-startup
}

layer-rule {
    match namespace="^launcher$"

    background-effect {
        blur true
    }
}

// Start the installed Noctalia shell for panels and desktop widgets.
spawn-at-startup "noctalia" "--daemon"

binds {
    // Apps
    Mod+Return { spawn "kitty"; }
    Mod+Space { spawn "fuzzel"; }
    Mod+Shift+B { spawn "google-chrome"; }
    Mod+Shift+F { spawn "thunar"; }

    // Window and column controls.
    Mod+W { close-window; }
    Mod+T { toggle-window-floating; }
    Mod+F { fullscreen-window; }
    Mod+R { switch-preset-column-width; }
    Mod+K { show-hotkey-overlay; }
    Mod+Left { focus-column-left; }
    Mod+Down { focus-window-down; }
    Mod+Up { focus-window-up; }
    Mod+Right { focus-column-right; }
    Mod+Shift+Left { move-column-left; }
    Mod+Shift+Down { move-window-down; }
    Mod+Shift+Up { move-window-up; }
    Mod+Shift+Right { move-column-right; }
    Alt+Tab { focus-window-previous; }


    // Number keys select workspace positions on the focused monitor.
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace 10; }
    Mod+Shift+1 { move-window-to-workspace 1; }
    Mod+Shift+2 { move-window-to-workspace 2; }
    Mod+Shift+3 { move-window-to-workspace 3; }
    Mod+Shift+4 { move-window-to-workspace 4; }
    Mod+Shift+5 { move-window-to-workspace 5; }
    Mod+Shift+6 { move-window-to-workspace 6; }
    Mod+Shift+7 { move-window-to-workspace 7; }
    Mod+Shift+8 { move-window-to-workspace 8; }
    Mod+Shift+9 { move-window-to-workspace 9; }
    Mod+Shift+0 { move-window-to-workspace 10; }
    Mod+Tab { focus-workspace-down; }
    Mod+Shift+Tab { focus-workspace-up; }
    Mod+Ctrl+Tab { focus-workspace-previous; }
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }

    // Audio, monitor brightness, and media controls remain usable while locked.
    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "-l" "1.0" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    Alt+XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "-l" "1.0" "@DEFAULT_AUDIO_SINK@" "1%+"; }
    Alt+XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "1%-"; }
    XF86AudioMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
    XF86AudioNext allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPrev allow-when-locked=true { spawn "playerctl" "previous"; }
    XF86AudioPlay allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPause allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "/home/akk/.config/niri/scripts/brightness.sh" "up" "5"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "/home/akk/.config/niri/scripts/brightness.sh" "down" "5"; }
    Alt+XF86MonBrightnessUp allow-when-locked=true { spawn "/home/akk/.config/niri/scripts/brightness.sh" "up" "1"; }
    Alt+XF86MonBrightnessDown allow-when-locked=true { spawn "/home/akk/.config/niri/scripts/brightness.sh" "down" "1"; }
}
